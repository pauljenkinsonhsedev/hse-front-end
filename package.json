{
  "name": "hse-front-end",
  "version": "6.7.0",
  "description": "",
  "scripts": {
    "powerwash": "rimraf node_modules ./secureroot/hseonline/website/livelive/secureroot/assets/v6-css ./secureroot/hseonline/website/livelive/secureroot/assets/v6-js ./designsystem/assets/v6-css && npm install",
    "build:css": "node scripts/build-css.mjs",
    "build:footer-css": "node scripts/build-footer-css.mjs",
    "build:ds-css": "node scripts/build-ds.mjs",
    "build:ds": "npm-run-all build:ds-css copy:ds-html copy:ds-images",
    "build:js": "rollup -c",
    "watch:js": "rollup -c --watch",
    "build:images": "node scripts/optimize-images.mjs",
    "copy:assets": "copyfiles -u 3 \"src/secureroot/assets/v6-js/cookies-6.7.0.js\" \"src/secureroot/assets/v6-images/icons/**/*\" ./secureroot/hseonline/website/livelive/secureroot/assets",
    "copy:html": "node scripts/copy-html.mjs",
    "copy:ds-html": "node scripts/copy-ds-html.mjs",
    "copy:ds-images": "node scripts/copy-ds-images.mjs",
    "copy:images": "node scripts/copy-images.mjs",
    "copy:static": "node scripts/copy-static.mjs",
    "copy:ajax": "node scripts/copy-ajax.mjs",
    "build:modern": "npm-run-all build:images copy:assets copy:static copy:html copy:images build:css build:footer-css build:ds build:js",
    "build:ds-modern": "npm-run-all build:ds build:js",
    "serve": "browser-sync start --server \"./secureroot/hseonline/website/livelive/secureroot\" --index \"index.htm\" --port 8080 --files \"./secureroot/hseonline/website/livelive/secureroot/**/*\" --ignore \"node_modules, .git, .vscode\" --no-notify --no-ui --startPath \"index.htm\" --open local",
    "serve:ds": "browser-sync start --config scripts/bs-config-ds.cjs",
    "watch:css": "node scripts/watch-css.mjs",
    "watch:ds": "node scripts/watch-ds.mjs",
    "watch:ds-html": "node scripts/watch-ds-html.mjs",
    "watch:html": "node scripts/watch-html.mjs",
    "watch:images": "node scripts/watch-images.mjs",
    "watch:ajax": "node scripts/watch-ajax.mjs",
    "watch:modern": "npm-run-all --parallel watch:css watch:ds watch:ds-html watch:js watch:html watch:images watch:ajax serve",
    "watch:ds-modern": "npm-run-all --parallel watch:ds watch:ds-html watch:js serve:ds",
    "dev": "npm-run-all build:modern watch:modern",
    "ds": "npm-run-all build:ds-modern watch:ds-modern",
    "press": "npm run build:css",
    "prod": "npm run build:modern"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/runtime-corejs3": "^7.29.2",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "autoprefixer": "^10.5.0",
    "browser-sync": "^3.0.4",
    "copyfiles": "^2.4.1",
    "core-js": "^3.49.0",
    "cssnano": "^7.1.7",
    "del": "^8.0.1",
    "glob": "^13.0.6",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-pxtorem": "^6.1.0",
    "postcss-scss": "^4.0.9",
    "prismjs": "^1.30.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.2",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "stylelint": "^17.9.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.0.0",
    "tidy-html5": "^0.1.1"
  },
  "dependencies": {
    "bowser": "^2.14.1",
    "clipboard": "^2.0.11",
    "highcharts": "^12.6.0",
    "js-cookie": "^3.0.5",
    "moment": "^2.30.1",
    "papaparse": "^5.5.3",
    "regenerator-runtime": "^0.14.1"
  }
}
