    "open-cli": "^8.0.0",
    "os": "^0.1.2",
    "path": "^0.12.7",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-pxtorem": "^6.1.0",
    "prismjs": "^1.30.0",
    "rename": "^1.0.4",
    "require-dir": "^1.2.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.59.0",
    "sass": "^1.98.0",
    "sass-loader": "^13.3.3",
    "stylelint": "^16.19.1",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-scss": "^6.12.0",
    "susy": "^3.0.6",
    "tidy-html5": "^0.1.1",
    "webpack": "^5.82.0",
    "webpack-bundle-analyzer": "^5.2.0",
    "webpack-cli": "^5.1.1",
    "webpack-dev-server": "^5.2.3",
    "webpack-node-externals": "^2.5.1",
    "webpack-stream": "^7.0.0",
    "whatwg-fetch": "^3.6.2"
  },
  "dependencies": {
    "a11y_accordions": "^3.2.1",
    "bowser": "^2.11.0",
    "clipboard": "^2.0.8",
    "highcharts": "^12.5.0",
    "js-cookie": "^2.2.1",
    "moment": "^2.29.4",
    "papaparse": "^5.3.2",
    "picturefill": "^3.0.3",
    "regenerator-runtime": "^0.14.1"
  }
}
