{
  "name": "hse-front-end",
  "version": "6.6.0",
  "description": "",
  "main": "gulpfile.babel.js",
  "scripts": {
    "powerwash": "rimraf node_modules .gulp-cache ./secureroot/hseonline/website/livelive/secureroot/assets/v6-css ./secureroot/hseonline/website/livelive/secureroot/assets/v6-js ./designsystem/assets/v6-css && npm install",
    "build:css": "cross-replace sass ./src/secureroot/v6-css/scss/v6.scss:./secureroot/hseonline/website/livelive/secureroot/assets/v6-css/%npm_package_version%.min.css --load-path=node_modules --style=compressed --no-source-map && postcss ./secureroot/hseonline/website/livelive/secureroot/assets/v6-css/%npm_package_version%.min.css --use autoprefixer --no-map -o ./secureroot/hseonline/website/livelive/secureroot/assets/v6-css/%npm_package_version%.min.css",
    "build:ds": "cross-replace sass ./src/secureroot/v6-css/scss/design-system.scss:./designsystem/assets/v6-css/%npm_package_version%.min.css --load-path=node_modules --style=compressed --no-source-map && postcss ./designsystem/assets/v6-css/%npm_package_version%.min.css --use autoprefixer --no-map -o ./designsystem/assets/v6-css/%npm_package_version%.min.css",
    "build:js": "rollup -c",
    "build:images": "node scripts/optimize-images.mjs",
    "copy:assets": "copyfiles -u 3 \"src/secureroot/assets/v6-js/cookies-6.6.0.js\" \"src/secureroot/assets/v6-images/icons/**/*\" ./secureroot/hseonline/website/livelive/secureroot/assets",
    "build:modern": "npm-run-all build:images copy:assets build:css build:ds build:js",
    "serve": "cross-replace browser-sync start --server \"./secureroot/hseonline/website/livelive/secureroot\" --index \"index.htm\" --port 8080 --files \"./secureroot/hseonline/website/livelive/secureroot/**/*\" --ignore \"node_modules, .git, .vscode\" --no-notify --no-ui --startPath \"index.htm\" && node -e \"import('open').then(o => o.default('http://localhost:8080'))\"",
    "watch:css": "cross-replace sass --watch ./src/secureroot/v6-css/scss/v6.scss:./secureroot/hseonline/website/livelive/secureroot/assets/v6-css/%npm_package_version%.min.css --load-path=node_modules --style=compressed --no-source-map",
    "watch:ds": "cross-replace sass --watch ./src/secureroot/v6-css/scss/design-system.scss:./designsystem/assets/v6-css/%npm_package_version%.min.css --load-path=node_modules --style=compressed --no-source-map",
    "watch:modern": "npm-run-all --parallel watch:css watch:ds \"build:js -- --watch\" \"serve\"",
    "dev": "npm-run-all build:modern watch:modern",
    "designsystem": "npm run build:ds",
    "press": "npm run build:css",
    "prod": "npm run build:modern"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=14.0.0 <23.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/runtime-corejs3": "^7.29.2",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "autoprefixer": "^10.4.27",
    "browser-sync": "^3.0.4",
    "colors": "^1.4.0",
    "copyfiles": "^2.4.1",
    "core-js": "^3.49.0",
    "cross-replace": "^0.2.0",
    "cssnano": "^7.1.3",
    "date-format": "^4.0.14",
    "del": "^8.0.1",
    "fs": "^0.0.2",
    "glob": "^13.0.6",
    "node-notifier": "^10.0.1",
    "npm-run-all": "^4.1.5",
    "open": "^11.0.0",
    "os": "^0.1.2",
    "path": "^0.12.7",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-pxtorem": "^6.1.0",
    "prismjs": "^1.30.0",
    "rename": "^1.0.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.0",
    "sass": "^1.98.0",
    "sass-loader": "^16.0.7",
    "sharp": "^0.34.5",
    "stylelint": "^17.6.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.0.0",
    "tidy-html5": "^0.1.1",
    "webpack-bundle-analyzer": "^5.3.0"
  },
  "dependencies": {
    "bowser": "^2.14.1",
    "clipboard": "^2.0.11",
    "highcharts": "^12.5.0",
    "js-cookie": "^3.0.5",
    "moment": "^2.30.1",
    "papaparse": "^5.5.3",
    "regenerator-runtime": "^0.14.1"
  }
}
