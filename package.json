{
  "name": "hse-front-end",
  "version": "6.6.0",
  "description": "",
  "main": "gulpfile.babel.js",
  "scripts": {
    "powerwash": "rimraf node_modules .gulp-cache ./secureroot/hseonline/website/livelive/secureroot/assets/v6-css ./secureroot/hseonline/website/livelive/secureroot/assets/v6-js ./designsystem/assets/v6-css && npm install",
    "build:css": "cross-var sass ./src/secureroot/v6-css/scss/v6.scss:./secureroot/hseonline/website/livelive/secureroot/assets/v6-css/%npm_package_version%.min.css --load-path=node_modules --style=compressed --no-source-map && postcss ./secureroot/hseonline/website/livelive/secureroot/assets/v6-css/%npm_package_version%.min.css --use autoprefixer --no-map -o ./secureroot/hseonline/website/livelive/secureroot/assets/v6-css/%npm_package_version%.min.css",
    "build:ds": "cross-var sass ./src/secureroot/v6-css/scss/design-system.scss:./designsystem/assets/v6-css/%npm_package_version%.min.css --load-path=node_modules --style=compressed --no-source-map && postcss ./designsystem/assets/v6-css/%npm_package_version%.min.css --use autoprefixer --no-map -o ./designsystem/assets/v6-css/%npm_package_version%.min.css",
    "build:js": "rollup -c",
    "build:images": "imagemin \"src/designsystem/images/**/*\" --out-dir=./designsystem/images",
    "copy:assets": "copyfiles -u 3 \"src/secureroot/assets/v6-js/cookies-6.6.0.js\" \"src/secureroot/assets/v6-images/icons/**/*\" ./secureroot/hseonline/website/livelive/secureroot/assets",
    "build:modern": "npm-run-all build:images copy:assets build:css build:ds build:js",
    "serve": "cross-var browser-sync start --server \"./secureroot/hseonline/website/livelive/secureroot\" --index \"index.htm\" --port 8080 --files \"./secureroot/hseonline/website/livelive/secureroot/**/*\" --ignore \"node_modules, .git, .vscode\" --no-notify --no-ui --startPath \"index.htm\"",
    "watch:css": "cross-var sass --watch ./src/secureroot/v6-css/scss/v6.scss:./secureroot/hseonline/website/livelive/secureroot/assets/v6-css/%npm_package_version%.min.css --load-path=node_modules --style=compressed --no-source-map",
    "watch:ds": "cross-var sass --watch ./src/secureroot/v6-css/scss/design-system.scss:./designsystem/assets/v6-css/%npm_package_version%.min.css --load-path=node_modules --style=compressed --no-source-map",
    "watch:modern": "npm-run-all --parallel watch:css watch:ds \"build:js -- --watch\" \"serve\"",
    "dev": "npm-run-all build:modern watch:modern",
    "designsystem": "npm run build:ds",
    "press": "npm run build:css",
    "prod": "npm run build:modern"
  },
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=14.0.0 <23.0.0"
  },
